          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voterId\": \"{{voterId}}\",\n  \"password\": \"candidatePass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register-candidate",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register-candidate"]
            }
          }
        },
        {
          "name": "Candidate Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
