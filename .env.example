# ==============================================================================
# ONLINE VOTING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO VERSION CONTROL.
# Copy this file to .env or configure directly in your cloud hosting provider
# (e.g., Render, Railway, AWS, Heroku, Docker).

# Active Spring Profile:
# Set to 'dev' for local testing and college demonstrations (admin/admin enabled)
# Set to 'prod' for production deployment (requires ADMIN_USERNAME & ADMIN_PASSWORD)
SPRING_PROFILES_ACTIVE=prod

# Production Admin Credentials (Required when SPRING_PROFILES_ACTIVE=prod)
# Startup will abort if either is missing, blank, or set to 'admin'
ADMIN_USERNAME=your_secure_admin_username
ADMIN_PASSWORD=your_unique_strong_password

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voting_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# Gmail SMTP Configuration
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_google_app_password

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# JWT Secret (HMAC-SHA256 256-bit+ key)
JWT_SECRET=4c7d9a1e8f2b5a6c3d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c
